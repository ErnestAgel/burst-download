# 构建产物
build/
build-tests/
build-tests-rel/
build-rel/
build-release/
.build-cache/
*.o
*.obj

# 仓库不跟踪的内容
.vscode/
zsync
PROGRESS.md

# 编辑器/系统
Thumbs.db

# 发布临时产物（已上传 GitHub Release）
release/dist/
build-arm/

# Python 运行时缓存（每次运行嵌入的 Python/yt_dlp 都会重新生成，不入库）
__pycache__/
*.py[cod]
*$py.class
# 解析组件自动更新节流时间戳（运行时生成，不入库）
.parser_last_check

# 运行日志
*.log

# Windows 构建目录
build-win/
build-win-release/

# *.pyd 是 Windows Python 扩展模块(非缓存),必须入库
!*.pyd

# 发布构建目录
build-rel-x64/
build-rel-arm64/
build-win-rel/
burst-build-win/

# 本地验证产物（assets 方案测试包，不入库）
release-assets-test/

# GUI Phase 0 临时构建目录
build-gui-p0/
build-gui-check/
build-wsl/
build-ui/

# GUI 运行时生成（布局/设置持久化，不入库）
imgui.ini
config.ini

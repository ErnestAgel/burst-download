# 构建产物
build/
build-rel/
build-release/
.build-cache/
*.o
*.obj

# 仓库不跟踪的内容
.vscode/
zsync
PROGRESS.md

# 编辑器/系统
Thumbs.db

# 发布临时产物（已上传 GitHub Release）
release/dist/
build-arm/

# Python 运行时缓存（每次运行嵌入的 Python/yt_dlp 都会重新生成，不入库）
__pycache__/
*.py[cod]
*$py.class

# 运行日志
*.log

# Windows 构建目录
build-win/
build-win-release/

# *.pyd 是 Windows Python 扩展模块(非缓存),必须入库
!*.pyd
